# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
# Keep pubspec.lock for this application repo so dependency resolution is reproducible.

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*
/firebase_config.json

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Generated by FlutterFire CLI for each developer/Firebase project.
/lib/firebase_options.dart
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/macos/Runner/GoogleService-Info.plist

# IDE and local tooling
.idea/
.vscode/
.DS_Store
*.iml

# Firebase local tools and generated files
firebase/node_modules/
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
emulator-data/
# Generated Kotlin Gradle files
/android/.kotlin/
